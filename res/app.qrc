<RCC>
    <qresource prefix="/app">
        <file alias="splashscreen">images/splashscreen.jpeg</file>
        <file alias="olbaflinx-ico">olbaflinx.ico</file>
        <file alias="olbaflinx-logo-16">olbaflinx-16.png</file>
        <file alias="olbaflinx-logo-24">olbaflinx-24.png</file>
        <file alias="olbaflinx-logo-32">olbaflinx-32.png</file>
        <file alias="olbaflinx-logo-48">olbaflinx-48.png</file>
        <file alias="olbaflinx-logo-64">olbaflinx-64.png</file>
        <file alias="olbaflinx-logo-128">olbaflinx-128.png</file>
        <file alias="olbaflinx-logo-256">olbaflinx-256.png</file>
        <file alias="olbaflinx-logo-512">olbaflinx-512.png</file>
        <file alias="olbaflinx-logo-1024">olbaflinx-1024.png</file>
        <file alias="olbaflinx-desktop">olbaflinx.desktop</file>
    </qresource>
    <qresource prefix="/datavault">
        <file alias="add">images/datavault/add.png</file>
        <file alias="menu">images/datavault/menu.png</file>
        <file alias="open">images/datavault/open.png</file>
    </qresource>
    <qresource prefix="/account">
        <file alias="bank">images/account/bank.png</file>
        <file alias="bank-account">images/account/bank-account.png</file>
    </qresource>
    <qresource prefix="/transaction">
        <file alias="transaction-documents">images/transaction/transaction-documents.png</file>
        <file alias="transaction-list">images/transaction/transaction-list.png</file>
        <file alias="transaction-transfer">images/transaction/transaction-transfer.png</file>
        <file alias="transaction-chart">images/transaction/transaction-chart.png</file>
    </qresource>
    <qresource prefix="/general">
        <file alias="add">images/general/add.svg</file>
        <file alias="edit">images/general/edit.svg</file>
        <file alias="export">images/general/export.svg</file>
        <file alias="import">images/general/import.svg</file>
        <file alias="lock">images/general/lock.svg</file>
        <file alias="refresh">images/general/refresh.svg</file>
        <file alias="save">images/general/save.svg</file>
        <file alias="undo">images/general/undo.svg</file>
        <file alias="question">images/general/question.svg</file>
    </qresource>
</RCC>
