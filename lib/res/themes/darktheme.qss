QWidget {
    background-color: #1e1e1e;
    color: #dddddd;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10.5pt;
}

QListWidget, QTabWidget, QTableView, QPlainTextEdit {
    background-color: #2b2b2b;
    border: none;
    color: #e0e0e0;
}

QListWidget::item {
    padding: 8px;
    color: #dddddd;
}

QListWidget::item:selected {
    background-color: #3d3d3d;
    color: #ffffff;
}

QTabBar::tab {
    background: #2b2b2b;
    padding: 6px 12px;
    margin-right: 1px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #4CAF50;
    color: #ffffff;
}

QComboBox, QPushButton {
    background-color: #3d3d3d;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px 8px;
    border-radius: 4px;
}

QGroupBox {
    border: 1px solid #444444;
    margin-top: 20px;
    padding: 10px;
}

QGroupBox:title {
    color: #aaaaaa;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

QPlainTextEdit {
    background-color: #101010;
    color: #dddddd;
    font-family: "Monospace";
    font-size: 9.5pt;
    border: none;
}
